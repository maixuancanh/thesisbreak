# Copy to .env in this directory. Never commit the populated file.
# Web and worker must receive the same server-side configuration.
APP_URL=http://localhost:3013
DATABASE_URL=
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# OpenAI-compatible provider. Use the actual supported model identifier.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=

# Market catalog and Sui account/object verification are separate probes.
TATUM_API_KEY=
# Enable only after the corresponding capability has been verified with your key.
TATUM_MARKETS_ENABLED=false
TATUM_RESEARCH_ENABLED=false
# Shared UTC daily credit ceiling. Zero disables paid-credit requests.
TATUM_DAILY_CREDIT_LIMIT=0
TATUM_SUI_RPC_URL=
# Sui account reads use the fixed Tatum native gRPC endpoint. The legacy RPC URL is unused.
# Optional independently known owner address; empty means owner matching is not claimed.
MEMWAL_OWNER_ADDRESS=

# Optional bookmaker quotes, independently licensed from Tatum market data.
ODDS_API_KEY=
BOOKMAKER_DAILY_CREDIT_LIMIT=0

# Application names mapped to MemWal.create({key, accountId, serverUrl}).
# Use a delegate created for THESISBREAK; keep its private key server-side.
MEMWAL_ACCOUNT_ID=
MEMWAL_AGENT_ID=
MEMWAL_DELEGATE_KEY=
MEMWAL_RELAYER_URL=https://relayer.memory.walrus.xyz

# Configure only after choosing a licensed, supported domain source.
SOURCE_PROVIDER_API_KEY=

# Independent NBA data. Games are the default; enable a paid feature only with access.
BALLDONTLIE_API_KEY=
BALLDONTLIE_FEATURES=games

# Optional simultaneous NBA bookmaker baseline; private server-side credential only.
BOOKMAKER_API_KEY=

# Private bearer shared only by the Cloudflare clock and this backend (32+ random bytes).
FORECAST_CRON_SECRET=

# Experience extraction: reservations count bounded attempts, not money or measured tokens.
LEARNING_DAILY_ATTEMPTS=100
LEARNING_OWNER_DAILY_ATTEMPTS=10
LEARNING_MAX_INPUT_BYTES=64000
LEARNING_MAX_OUTPUT_TOKENS=3500
# Pick reason monitoring rollout. Enable only after migration0037 and acceptance.
PICK_REASON_MONITORING_ENABLED=false
PICK_REVIEW_UI_ENABLED=false
# Review cases, claim challenges, explanation review and read-only check procedures.
# Apply migrations through0039 before enabling. Existing per-owner consent still applies.
THESISBREAK_ACCOUNTABILITY_ENABLED=false
# Server-reviewed per-watch source mappings; never browser-controlled selectors.
SOURCE_WATCH_OFFICIAL_LINEUP_TARGETS_JSON=[]
SOURCE_WATCH_REVIEWED_REPORT_TARGETS_JSON=[]
# Optional bounded remote assessment of confirmed prose conditions.
# Reuses LLM_* and LEARNING_* attempt budgets; deterministic source checking remains local.
PICK_IMPACT_PROSE_ENABLED=false
# Optional server-registered structured publisher report targets keyed by existing watch ID.
SOURCE_WATCH_REVIEWED_REPORT_TARGETS_JSON=
# Optional official NBA targets; fresh-owner verified market/player templates configure watches automatically.
SOURCE_WATCH_OFFICIAL_LINEUP_TARGETS_JSON=
