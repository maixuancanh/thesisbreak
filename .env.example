# Copy to .env in this directory. Never commit the populated file.
# Web and worker must receive the same server-side configuration.
APP_URL=http://localhost:3013
DATABASE_URL=
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# OpenAI-compatible provider. Use the actual supported model identifier.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=

# Market catalog and Sui account/object verification are separate probes.
TATUM_API_KEY=
# Enable only after the corresponding capability has been verified with your key.
TATUM_MARKETS_ENABLED=false
TATUM_RESEARCH_ENABLED=false
# Shared UTC daily credit ceiling. Zero disables paid-credit requests.
TATUM_DAILY_CREDIT_LIMIT=0
TATUM_SUI_RPC_URL=
# Sui account reads use the fixed Tatum native gRPC endpoint. The legacy RPC URL is unused.
# Optional independently known owner address; empty means owner matching is not claimed.
MEMWAL_OWNER_ADDRESS=

# Optional bookmaker quotes, independently licensed from Tatum market data.
ODDS_API_KEY=
BOOKMAKER_DAILY_CREDIT_LIMIT=0

# Application names mapped to MemWal.create({key, accountId, serverUrl}).
# Use a delegate created for THESISBREAK; keep its private key server-side.
MEMWAL_ACCOUNT_ID=
MEMWAL_AGENT_ID=
MEMWAL_DELEGATE_KEY=
MEMWAL_RELAYER_URL=https://relayer.memory.walrus.xyz

# Configure only after choosing a licensed, supported domain source.
SOURCE_PROVIDER_API_KEY=

# Independent NBA data. Games are the default; enable a paid feature only with access.
BALLDONTLIE_API_KEY=
BALLDONTLIE_FEATURES=games

# Optional simultaneous NBA bookmaker baseline; private server-side credential only.
BOOKMAKER_API_KEY=
